{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "elemental-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://tgelemental.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elemental-game",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
